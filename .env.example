# ============================================================================
# Production .env for Docker Compose. Copy to `.env` and fill in real values.
#   cp .env.example .env   &&   nano .env
# Never commit the real .env.
# ============================================================================

# --- Django core ------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# Your VPS IP and/or domain (comma-separated).
# MUST include the dashboard's subdomain (e.g. app.example.com): the
# dashboard's nginx forwards `proxy_set_header Host $host`, so a same-origin
# call to https://app.<domain>/api/v1/... arrives at Django with that Host
# header. A bare apex domain does NOT cover subdomains, so omitting it means
# Django answers 400 on every proxied API request.
# MUST also include "localhost": the container HEALTHCHECK probes /health/
# over loopback, and a Host header not listed here is rejected with 400.
ALLOWED_HOSTS=api.example.com,app.example.com,123.45.67.89,localhost,127.0.0.1
# Full https origins for CSRF (admin / browsable API). Include the API's own
# origin (https://api.<domain>) -- the admin and browsable API are served
# from there and issue same-origin POSTs that Django's CSRF check verifies
# against this list.
CSRF_TRUSTED_ORIGINS=https://api.example.com,https://app.example.com
# Comma-separated browser origins allowed to call this API with credentials.
# Production MUST list every real frontend origin here -- nothing is implied.
# Local dev servers (localhost:5173/:3000) are added automatically when
# DEBUG=True and are never trusted when DEBUG=False.
CORS_ALLOWED_ORIGINS=https://your-domain.com

# --- Database (Postgres + pgvector, the `db` service) -----------------------
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=change-me-strong-db-password
# Django reads this; host `db` is the compose service name.
DATABASE_URL=postgres://chatbot:change-me-strong-db-password@db:5432/chatbot

# --- Redis / Celery (the `redis` service) -----------------------------------
REDIS_URL=redis://redis:6379/0
USE_REDIS_CACHE=True
# Run document ingestion on the Celery worker.
INGESTION_MODE=celery

# --- RAG / vector backend ---------------------------------------------------
# Use pgvector in production for fast search at scale.
RAG_VECTOR_BACKEND=pgvector
RAG_SIMILARITY_THRESHOLD=0.45
RAG_TOP_K=6
RAG_FETCH_K=40

# --- LLM / embeddings (OpenAI) ----------------------------------------------
OPENAI_API_KEY=sk-...
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large

# --- Email (verification + account activation) ------------------------------
# Leave EMAIL_HOST empty to print emails to the console (dev). Set it for real
# SMTP (e.g. Gmail app password, SendGrid).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=you@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Your Brand <you@example.com>
# IMPORTANT: the base URL of your FRONTEND (not the API). Account-activation and
# email links are built as {FRONTEND_URL}/verify-email?uid=...&token=...
# If this is wrong, users get a broken localhost link. Set it to your real site.
FRONTEND_URL=https://your-frontend-domain.com

# --- Paddle (Billing) -------------------------------------------------------
# Server API key + the WEBHOOK signing secret (Paddle dashboard > Notifications).
# Start in sandbox; switch PADDLE_ENV to "production" only after testing.
PADDLE_ENV=sandbox
PADDLE_API_KEY=pdl_sdbx_apikey_...
PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
# Points: every OpenAI call is charged at its real cost (1 point = $0.001).
# Monthly points for a tenant with no plan (see also plan.points), and the
# points held before each chat answer (settled to the real cost after it).
FREE_TIER_POINTS=300
CHAT_POINTS_RESERVE=20

# --- Per-tenant quota defaults (optional overrides) -------------------------
TENANT_MAX_DOCUMENTS=100
TENANT_MAX_TOTAL_MB=200
TENANT_MAX_REQUESTS_PER_MIN=60
TENANT_MONTHLY_TOKEN_CAP=0
MAX_UPLOAD_SIZE_MB=20

# --- HTTPS hardening (set after TLS is live) --------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# --- WhatsApp (optional) ----------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# --- Voice ordering (ElevenLabs Agents, optional) ---------------------------
# Workspace secret ElevenLabs signs post-call webhooks with (Agents >
# Settings > Webhooks). Unset = every post-call webhook is refused.
# ELEVENLABS_WEBHOOK_SECRET=

# --- Rolling deploys ---------------------------------------------------------
# Path checked by /health/. While this file exists the probe returns 503 so the
# replica leaves rotation before a rolling deploy stops it. Leave the default
# unless the container filesystem layout changes.
DRAIN_FILE=/tmp/drain

# --- Security-critical (the service refuses to boot without these in prod) ---
# SECRET_KEY also signs every JWT. A known value lets anyone forge a token for
# any account. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Meta app secret. Every webhook delivery is HMAC-verified against it; without
# it the endpoint refuses all traffic (see WHATSAPP_REQUIRE_SIGNATURE).
WHATSAPP_APP_SECRET=
# Leave at 1. Setting 0 accepts unverified webhook deliveries -- anyone knowing
# the URL could then spend tenant points and send from tenant numbers.
WHATSAPP_REQUIRE_SIGNATURE=1
# Answer incoming messages after the webhook returned 200 ("thread"; Meta
# re-delivers slow webhooks). Context per answer: up to N earlier messages of
# the conversation from the last M minutes.
# WHATSAPP_PROCESS_MODE=thread
# WHATSAPP_HISTORY_MESSAGES=10
# WHATSAPP_HISTORY_MINUTES=60
# Embedded Signup: tenants connect their own number from the dashboard. The
# Meta App id and the "Facebook Login for Business" configuration id (both
# public); the button stays hidden until both are set. Uses WHATSAPP_APP_SECRET.
# WHATSAPP_APP_ID=
# WHATSAPP_ES_CONFIG_ID=
# WHATSAPP_GRAPH_VERSION=v23.0
# Fernet key for the per-number tokens stored in the database. Unset = derived
# from SECRET_KEY (rotating SECRET_KEY then means reconnecting every number).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WHATSAPP_TOKEN_KEY=

# Let nginx deliver authorised document downloads via X-Accel-Redirect. On in
# Docker (nginx marks /protected-media/ internal); off for runserver.
USE_X_ACCEL_REDIRECT=1
